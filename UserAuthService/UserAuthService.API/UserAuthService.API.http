@UserAuthService.API_HostAddress = http://localhost:5177
@AdminToken = paste-admin-jwt-here

GET {{UserAuthService.API_HostAddress}}/api/admin/dashboard
Accept: application/json
Authorization: Bearer {{AdminToken}}

###

GET {{UserAuthService.API_HostAddress}}/api/admin/notification-logs?page=1&pageSize=20&channel=Email&status=Sent
Accept: application/json
Authorization: Bearer {{AdminToken}}

###

GET {{UserAuthService.API_HostAddress}}/api/admin/notification-logs/summary
Accept: application/json
Authorization: Bearer {{AdminToken}}

###

POST {{UserAuthService.API_HostAddress}}/api/admin/notification-logs
Content-Type: application/json
Authorization: Bearer {{AdminToken}}

{
  "channel": "Email",
  "recipient": "user@example.com",
  "subject": "Diagram review completed",
  "status": "Sent",
  "provider": "SMTP",
  "providerMessageId": "provider-message-id",
  "correlationId": "review-id",
  "sentAt": "2026-07-23T07:00:00Z"
}

###
