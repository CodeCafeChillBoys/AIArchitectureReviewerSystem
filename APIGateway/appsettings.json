{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "userAuthRoute": {
        "ClusterId": "userAuthCluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "userAuthApiRoute": {
        "ClusterId": "userAuthCluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "userApiRoute": {
        "ClusterId": "userAuthCluster",
        "Match": {
          "Path": "/api/user/{**catch-all}"
        }
      },
      "diagramManagerRoute": {
        "ClusterId": "diagramManagerCluster",
        "Match": {
          "Path": "/diagram/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "diagramWorkspacesRoute": {
        "ClusterId": "diagramManagerCluster",
        "Match": {
          "Path": "/api/Workspaces/{**catch-all}"
        }
      },
      "diagramsRoute": {
        "ClusterId": "diagramManagerCluster",
        "Match": {
          "Path": "/api/Diagrams/{**catch-all}"
        }
      },
      "diagramSharesRoute": {
        "ClusterId": "diagramManagerCluster",
        "Match": {
          "Path": "/api/DiagramShares/{**catch-all}"
        }
      },
      "aiReviewerRoute": {
        "ClusterId": "aiReviewerCluster",
        "Match": {
          "Path": "/ai/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "aiReviewRoute": {
        "ClusterId": "aiReviewerCluster",
        "Match": {
          "Path": "/api/Review/{**catch-all}"
        }
      },
      "aiSystemRulesRoute": {
        "ClusterId": "aiReviewerCluster",
        "Match": {
          "Path": "/api/system-rules/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "userAuthCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7158"
          }
        }
      },
      "diagramManagerCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7065"
          }
        }
      },
      "aiReviewerCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7257"
          }
        }
      }
    }
  }
}
